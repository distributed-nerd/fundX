{
  "name": "fundx-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:studio": "drizzle-kit studio",
    "test:api": "node test/api.e2e.mjs",
    "test:ussd": "node test/ussd.e2e.mjs",
    "test:e2e": "node test/api.e2e.mjs && node test/ussd.e2e.mjs",
    "db:reset": "tsx src/db/reset.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "One API, two front doors: the FundX web app and USSD",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "africastalking": "^0.7.9",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "hash-wasm": "^4.12.0",
    "pg": "^8.23.0",
    "quais": "^1.0.0-alpha.56",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
