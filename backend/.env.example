NODE_ENV=development
PORT=4000

DATABASE_URL="postgres://fundx:fundx@localhost:5433/fundx"

# Chain. "mock" runs entirely in Postgres; "quai" talks to Orchard.
CHAIN_ADAPTER="mock"
CHAIN_ID=15000
RPC_URL="https://orchard.rpc.quai.network"
MOCK_USDT_ADDRESS=""

# Master seed for user key derivation. Every user's key is derived from this and NOTHING
# is stored in the database. Losing it loses every user's funds; leaking it is the same as
# leaking all of them. In production this belongs in a KMS, not a file.
MASTER_MNEMONIC=""

# Treasury that drips QUAI so user addresses can pay their own gas.
TREASURY_PK=""

# Cookie signing / token hashing.
SESSION_SECRET=""

# Africa's Talking. The USSD callback is POST / — point the dashboard at the host.

# Leave USERNAME=sandbox for the simulator.
AT_USERNAME="sandbox"
AT_API_KEY=""
AT_SENDER_ID=""
