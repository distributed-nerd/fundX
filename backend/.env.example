NODE_ENV=development
PORT=4000

DATABASE_URL="postgres://fundx:fundx@localhost:5433/fundx"

# Chain. "mock" runs entirely in Postgres; "quai" talks to Orchard.
CHAIN_ADAPTER="mock"
CHAIN_ID=15000
RPC_URL="https://orchard.rpc.quai.network"
MOCK_USDT_ADDRESS=""

# Master seed for user key derivation. Every user's key is derived from this and NOTHING
# is stored in the database. Losing it loses every user's funds; leaking it is the same as
# leaking all of them. In production this belongs in a KMS, not a file.
MASTER_MNEMONIC=""

# Treasury that drips QUAI so user addresses can pay their own gas.
TREASURY_PK=""

# Cookie signing / token hashing.
SESSION_SECRET=""

# Africa's Talking. The USSD callback is POST / — point the dashboard at the host.

# Leave USERNAME=sandbox for the simulator.
AT_USERNAME="sandbox"
AT_API_KEY=""
AT_SENDER_ID=""

# Paystack. Required for account-name resolution; without it the endpoint reports
# "unavailable" rather than inventing a name. Test keys start sk_test_.
PAYSTACK_SECRET_KEY=""

# Browser origins allowed to call this API with credentials.
WEB_ORIGINS="http://localhost:3000"

# SMS. "termii" (default, best for Nigeria), "africastalking", or "none".
# Without a key the provider logs instead of sending, and POST /auth/otp/request returns the
# code as devCode so the e2e suites work offline. Configure a key and that stops immediately.
SMS_PROVIDER="termii"
SMS_SENDER_ID="FundX"
TERMII_API_KEY=""
# Outside production, only these numbers receive real SMS (comma separated, E.164).
# Empty means nothing sends — which keeps e2e runs from texting strangers and burning credit.
SMS_ALLOWLIST=""

# Numbers starting with this prefix never receive a real SMS, in any environment. The test
# suites generate numbers under it deliberately. This exists because a test OTP once went to
# a real stranger's phone and cost ₦5.90 to do it.
SMS_TEST_PREFIX="+2349000"

# How long a send waits for a receipt before returning "pending" and settling in the
# background. Orchard's block interval measured ~27s, so on that chain this almost always
# expires — which is the intended behaviour, not a failure.
CONFIRM_BUDGET_MS="8000"
